# Long random secret used to sign physical OBJECT encounter tokens.
FIRST_CONTACT_SIGNING_SECRET=

# Upstash Redis REST credentials used for durable encounter responses.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Separate private key for /hello/inbox.
FIRST_CONTACT_ADMIN_KEY=

# Optional: duplicate saved responses to a private webhook destination.
FIRST_CONTACT_DELIVERY_WEBHOOK_URL=
